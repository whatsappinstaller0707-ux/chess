+/* ---- Last move / check indicators (v2 visual upgrade) ---- */
+.square.last-move-from::after,
+.square.last-move-to::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: rgba(245, 158, 11, 0.22);
+  box-shadow: inset 0 0 0 2px rgba(245, 158, 11, 0.55);
+  pointer-events: none;
+}
+
+.square.king-in-check::before {
+  content: '';
+  position: absolute;
+  inset: 6%;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(239,68,68,0.85) 0%, rgba(239,68,68,0.15) 70%, transparent 100%);
+  animation: check-pulse 0.9s ease-in-out infinite;
+  z-index: 4;
+}
+@keyframes check-pulse {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 1; }
+}
+
+/* ---- Wooden board surface (used by default/classic + gold themes) ---- */
+.board.board-wood .square.light { background: linear-gradient(160deg, var(--board-light), color-mix(in srgb, var(--board-light) 85%, #7c4a12)); }
+.board.board-wood .square.dark { background: linear-gradient(160deg, var(--board-dark), color-mix(in srgb, var(--board-dark) 80%, #000)); }
+
+/* ---- Piece animation: smooth slide + settle ---- */
 .piece-svg {
   width: 85%;
   height: 85%;
   z-index: 5;
   filter: drop-shadow(0 3px 4px rgba(0,0,0,0.5));
+  animation: piece-settle 0.22s cubic-bezier(.34,1.56,.64,1);
+}
+@keyframes piece-settle {
+  from { transform: scale(0.55); opacity: 0.3; }
+  to { transform: scale(1); opacity: 1; }
+}
+.piece-svg.captured-piece {
+  animation: piece-capture-pop 0.32s ease forwards;
+}
+@keyframes piece-capture-pop {
+  0% { transform: scale(1); opacity: 1; }
+  60% { transform: scale(1.35); opacity: 0.55; }
+  100% { transform: scale(0.15); opacity: 0; }
+}
+
+/* ---- Checkmate flourish over the whole board ---- */
+.board.checkmate-flash {
+  animation: checkmate-glow 1.1s ease-in-out 2;
+}
+@keyframes checkmate-glow {
+  0%, 100% { box-shadow: 0 8px 25px rgba(0,0,0,0.6); }
+  50% { box-shadow: 0 0 0 6px var(--accent-glow), 0 8px 30px rgba(0,0,0,0.6); }
+}
+
+/* ---- Captured-pieces tray ---- */
+.captured-tray {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 2px;
+  min-height: 26px;
+  align-items: center;
+  padding: 0 0.25rem;
+}
+.captured-tray .piece-svg {
+  width: 18px;
+  height: 18px;
+  opacity: 0.85;
+  filter: none;
+  animation: none;
 }
 
